	  ^
	  ../ext/qt/gstqtgl.h:49:16: note: expanded from macro 'GLsync'
	  #define GLsync gst_qt_GLsync
	  ^
	  6 errors generated.
	  Instead, we simply avoid defining GLsync ourselves if we're using Qt.

